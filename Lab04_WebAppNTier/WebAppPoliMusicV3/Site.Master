<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebAppPoliMusicV3.SiteMaster" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>PoliMusic V3</title><link runat="server" rel="stylesheet" href="~/Content/site.css" /><asp:ContentPlaceHolder ID="HeadContent" runat="server" /></head>
<body><form id="formMain" runat="server"><asp:ScriptManager ID="scriptManager" runat="server" EnablePartialRendering="true" />
<aside class="sidebar"><a class="brand" runat="server" href="~/Default">♪ POLIMUSIC<span class="brand-dot">.</span></a><span class="student-brand">PoliMusic - isabella.hernandez</span><span class="nav-caption">TU MÚSICA</span><a class="nav-item" runat="server" href="~/Default">⌂ &nbsp; Inicio</a><a class="nav-item active" runat="server" href="~/Song">♫ &nbsp; Canciones</a><asp:HyperLink ID="lnkAdmin" runat="server" CssClass="nav-item" NavigateUrl="~/DesktopAdmin.aspx" Visible="false">Administración</asp:HyperLink>
<div class="sidebar-bottom"><span class="avatar">♫</span><span><strong><asp:Literal ID="litUser" runat="server" Mode="Encode" /></strong><small>Tu espacio musical</small></span><a runat="server" href="~/Logout" title="Cerrar sesión" aria-label="Cerrar sesión">↗</a></div></aside>
<main class="library-main"><header class="topbar"><span class="breadcrumb">PoliMusic <span>/</span> Isabella Hernández</span><a class="logout-link" runat="server" href="~/Logout">Cerrar sesión</a></header><asp:ContentPlaceHolder ID="MainContent" runat="server" /><footer>Hecho para escuchar. <span>PoliMusic · Isabella Hernández · Laboratorio 04</span></footer></main>
</form><script src="<%= ResolveUrl("~/Content/player.js") %>"></script></body></html>
