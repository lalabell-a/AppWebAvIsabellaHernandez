<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="maxSongLength" value="52428800" />
    <add key="albumImagePath" value="~/AlbumImages/" />
    <add key="artistImagePath" value="~/ArtistImages/" />
    <add key="userPhotoPath" value="~/UserImages/" />
    <add key="songFolderPath" value="~/SongFiles/" />
    <add key="playlistFolderPath" value="~/PlaylistImages/" />
  </appSettings>
  <connectionStrings configSource="ConnectionStrings.local.config">
  </connectionStrings>
  <system.web>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="es-EC" uiCulture="es" />
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime maxRequestLength="51200" enableVersionHeader="false" targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="20" protection="All" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <sessionState cookieless="UseCookies" timeout="20" />
    <customErrors mode="RemoteOnly" />
    <pages validateRequest="true" enableViewStateMac="true" clientIDMode="Static">
      <controls />
    </pages>
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="SignUp.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment="SongFiles" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <location path="Login">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="SignUp">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>